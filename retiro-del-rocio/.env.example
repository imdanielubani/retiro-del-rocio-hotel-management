APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail / Google Workspace SMTP. Use a Google "App Password" (not your login password).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paystack (test or live)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# TTLock smart locks — single source of truth for all credentials/tokens.
# Use https://api.ttlock.com for the US region, https://euapi.ttlock.com for EU.
TTLOCK_BASE_URL=https://euapi.ttlock.com
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_ACCESS_TOKEN=
TTLOCK_REFRESH_TOKEN=
# Access Gate lock ID(s) that all guest passcodes/QR codes are issued against.
# For a single gate use one ID; for multiple gates use a comma-separated list
# (e.g. 32950580,32950590) — the guest gets ONE shared passcode that opens every gate.
TTLOCK_LOCK_ID=
TTLOCK_UID=
TTLOCK_OPENID=
TTLOCK_SCOPE=
TTLOCK_TOKEN_TYPE=Bearer
TTLOCK_EXPIRES_IN=
# Default guest access window (24h HH:MM)
TTLOCK_CHECKIN_TIME=14:00
TTLOCK_CHECKOUT_TIME=12:00
# How passcodes reach the lock: 1=bluetooth, 2=gateway, 3=NB-IoT
TTLOCK_ADD_TYPE=2
TTLOCK_TIMEOUT=15
TTLOCK_RETRIES=2
